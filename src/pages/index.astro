---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Peter Kerins | Software Engineer">
  <main class="relative mx-auto flex w-full max-w-7xl flex-1 items-center px-5 py-16 sm:px-6 lg:px-8">
    <section class="text-white">
      <h2 class="max-w-[16ch] text-balance text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl">
        Designing and building web products.
      </h2>

      <p class="mt-6 max-w-[58ch] text-pretty text-lg text-cyan-50/75 sm:text-base">
        I’m a Kilkenny-based software engineer working with JavaScript and React to turn product ideas into clear, reliable interfaces.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="mailto:hello@peterkerins.com"
          class="inline-flex items-center justify-center rounded-md bg-white px-4 py-3 text-base font-medium text-cyan-950 ring-1 ring-white transition hover:bg-cyan-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-200 sm:text-sm"
        >
          Get in touch
        </a>
        <a
          href="https://github.com/writes-of-spring"
          class="inline-flex items-center justify-center rounded-md border border-white/20 px-4 py-3 text-base font-medium text-white transition hover:border-white/35 hover:bg-white/6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-200 sm:text-sm"
        >
          View GitHub
        </a>
      </div>
    </section>
  </main>
</Layout>
