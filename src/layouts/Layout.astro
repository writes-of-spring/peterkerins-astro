---
import "../styles/global.css";
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#164e63" />
    <meta
      name="description"
      content="Peter Kerins is a Kilkenny Based Software Engineer. Creates application interfaces in javascript & react"
    />
    <title>{title}</title>
  </head>
  <body class="bg-gradient-to-br from-cyan-900 to-sky-800 h-screen">
    <header class="mx-auto max-w-7xl px-4 sm:px-0 py-8">
      <h1 class="text-4xl lg:text-5xl font-sans font-semibold text-white">
        Peter Kerins
      </h1>
    </header>
    <slot />
    <footer class="fixed bottom-0 w-full">
      <div
        class="mx-auto max-w-7xl py-6 lg:py-12 px-6 md:flex md:items-center md:justify-between lg:px-8"
      >
        <div class="flex justify-center space-x-6 md:order-2">
          <a
            href="https://www.instagram.com/pete.png/"
            class="text-gray-100 hover:text-gray-300"
          >
            <span class="sr-only">Instagram</span>
            <img src="/icons/instagram.svg" alt="" class="h-6 w-6" />
          </a>

          <a
            href="https://github.com/writes-of-spring"
            class="text-gray-100 hover:text-gray-300"
          >
            <span class="sr-only">GitHub</span>
            <img src="/icons/github.svg" alt="" class="h-6 w-6" />
          </a>

          <a
            href="mailto:hello@peterkerins.com"
            class="text-gray-100 hover:text-gray-300"
          >
            <span class="sr-only">Email</span>
            <img src="/icons/email.svg" alt="" class="h-6 w-6 flex-shrink-0" />
          </a>
        </div>
        <div class="mt-8 md:order-1 md:mt-0">
          <p class="text-center text-xs leading-5 text-gray-100">
            &copy; 2025 Peter Kerins
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
